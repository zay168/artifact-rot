.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.env

# Runs are immutable and never cleaned (PLAN.md §5), but they are not versioned by
# default: they can be heavy and are published separately with the report. The
# directory itself is kept.
runs/*
!runs/.gitkeep

# Full-text cache: bulky, rebuildable, not versioned.
data/fulltext/
data/queue.sqlite3*
